---
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>EngineerTech AI | Manufacturing Test, Automation & AI Solutions</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>

  <body>
    <nav class="navbar">
      <div class="logo">EngineerTech<span>AI</span></div>

      <div class="nav-links">
        <a href="#services">Services</a>
        <a href="#industries">Industries</a>
        <a href="#about">About</a>
        <a class="nav-button" href="#contact">Contact</a>
      </div>
    </nav>

    <header class="hero">
      <div class="hero-content">
        <p class="eyebrow">Manufacturing Test • Automation • AI Workflows</p>

        <h1>Engineering solutions for smarter manufacturing.</h1>

        <p class="hero-text">
          Helping manufacturers improve test systems, reduce downtime, automate
          workflows, and integrate AI into engineering operations.
        </p>

        <a class="button" href="#contact">Request a Consultation</a>
      </div>
    </header>

    <main>
      <section id="services" class="section">
        <p class="eyebrow">Services</p>
        <h2>Manufacturing Test, Automation & AI Solutions</h2>

        <div class="grid">
          <div class="card">
            <h3>Manufacturing Test</h3>
            <p>Production test systems, validation, troubleshooting, and reliability improvement.</p>
          </div>

          <div class="card">
            <h3>LabVIEW & TestStand</h3>
            <p>Automated test development, debugging, sequence improvement, and platform support.</p>
          </div>

          <div class="card">
            <h3>PXI & Instrumentation</h3>
            <p>PXI troubleshooting, calibration issues, instrumentation support, and integration.</p>
          </div>

          <div class="card">
            <h3>Process Automation</h3>
            <p>Automating repetitive engineering, reporting, documentation, and manufacturing workflows.</p>
          </div>

          <div class="card">
            <h3>AI Workflow Integration</h3>
            <p>Practical AI tools for documentation, OCR, data extraction, and internal knowledge systems.</p>
          </div>

          <div class="card">
            <h3>Technical Problem Solving</h3>
            <p>Root-cause analysis, electronics troubleshooting, quality support, and Class 3 rework experience.</p>
          </div>
        </div>
      </section>

      <section id="industries" class="section dark-section">
        <p class="eyebrow">Industries</p>
        <h2>Experience where quality, traceability, and uptime matter.</h2>

        <div class="pill-row">
          <span>Medical Devices</span>
          <span>Aerospace</span>
          <span>Defense & Military</span>
          <span>Class 3 Electronics</span>
          <span>Industrial Electronics</span>
          <span>Contract Manufacturing</span>
        </div>
      </section>

      <section id="about" class="section">
        <p class="eyebrow">About</p>
        <h2>16+ years supporting high-reliability electronics manufacturing.</h2>

        <p class="about-text">
          EngineerTech AI provides hands-on consulting support for manufacturing test,
          automation, troubleshooting, documentation, and AI-powered workflow improvement.
          Experience includes medical, aerospace, defense, military, Class 3 electronics,
          and high-reliability production environments.
        </p>
      </section>

      <section id="contact" class="section contact-section">
        <h2>Need manufacturing test or automation support?</h2>
        <p>
          Available for contract consulting, project-based engineering support,
          automation initiatives, and AI workflow integration.
        </p>

        <a class="button" href="mailto:info@engineertech.ai">Contact EngineerTech AI</a>
      </section>
    </main>

    <footer>
      EngineerTech AI © 2026
    </footer>
  </body>
</html>
